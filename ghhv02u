        RenderObjectUtils.new("UIListLayout", { Parent = objects.SideLeft, HorizontalAlignment = "Right", Padding = UDim.new(0, 1) })
        RenderObjectUtils.new("UIListLayout", { Parent = objects.SideRight, HorizontalAlignment = "Left", Padding = UDim.new(0, 1) })
        RenderObjectUtils.new("UIListLayout", { Parent = objects.SideBottom, HorizontalAlignment = "Center", VerticalAlignment = "Top", Padding = UDim.new(0, 1) })
        RenderObjectUtils.new("UIListLayout", { Parent = objects.SideTop, HorizontalAlignment = "Center", Padding = UDim.new(0, 1), VerticalAlignment = "Bottom" })

        RenderObjectUtils.new("UIPadding", { PaddingTop = UDim.new(0, 0), PaddingBottom = UDim.new(0, 0), Parent = objects.SideLeft, PaddingRight = UDim.new(0, 4), PaddingLeft = UDim.new(0, 0) })
        RenderObjectUtils.new("UIPadding", { PaddingTop = UDim.new(0, 0), PaddingBottom = UDim.new(0, 0), Parent = objects.SideRight, PaddingRight = UDim.new(0, 0), PaddingLeft = UDim.new(0, 4) })
        RenderObjectUtils.new("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 0), Parent = objects.SideBottom, PaddingRight = UDim.new(0, 0), PaddingLeft = UDim.new(0, 0) })
        RenderObjectUtils.new("UIPadding", { PaddingTop = UDim.new(0, 0), PaddingBottom = UDim.new(0, 3), Parent = objects.SideTop, PaddingRight = UDim.new(0, 0), PaddingLeft = UDim.new(0, 0) })

        objects.Name = RenderObjectUtils.new("TextLabel", { Text = player.Name, FontFace = SmallestPixel7, TextSize = 9, Parent = objects.SideTop })
        objects.NameOutline = RenderObjectUtils.new("UIStroke", { Parent = objects.Name, Thickness = 1, Color = Color3.fromRGB(0, 0, 0), LineJoinMode = "Miter" })
        FixTextPadding(objects.Name)

        objects.Distance = RenderObjectUtils.new("TextLabel", { Text = "0m", FontFace = SmallestPixel7, TextSize = 9, Parent = objects.SideBottom })
        objects.DistanceOutline = RenderObjectUtils.new("UIStroke", { Parent = objects.Distance, Thickness = 1, Color = Color3.fromRGB(0, 0, 0), LineJoinMode = "Miter" })
        FixTextPadding(objects.Distance)

        objects.HealthBarHolder = RenderObjectUtils.new("Frame", {
            Visible = false, Parent = objects.FrameHolder, BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0,
            Size = UDim2.new(0, 1, 1, 2), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(0, -4, 0, -1), BorderSizePixel = 0, ZIndex = 4, ClipsDescendants = true,
        })
        objects.HealthBarFill = RenderObjectUtils.new("Frame", {
            Parent = objects.HealthBarHolder, BackgroundColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 0,
            Size = UDim2.new(1, 0, 1, 0), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0, ZIndex = 5,
        })
        objects.HealthBarOutline = RenderObjectUtils.new("UIStroke", { Parent = objects.HealthBarHolder, Thickness = 1, Color = Color3.fromRGB(0, 0, 0), LineJoinMode = "Miter" })

        objects.HealthBarNumber = RenderObjectUtils.new("TextLabel", {
            Text = "100", FontFace = SmallestPixel7, TextSize = 9, Parent = objects.FrameHolder,
            TextColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 1, ZIndex = 7,
            AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0, 0, 0, 0), Size = UDim2.fromOffset(30, 12), ClipsDescendants = false,
        })
        objects.HealthBarNumberOutline = RenderObjectUtils.new("UIStroke", { Parent = objects.HealthBarNumber, Thickness = 1, Color = Color3.fromRGB(0, 0, 0), LineJoinMode = "Miter" })

        objects.HealthBarFillGradient = RenderObjectUtils.new("UIGradient", { Parent = objects.HealthBarFill, Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(0, 255, 0), Color3.fromRGB(255, 0, 0)) })

        objects.BoxFill = RenderObjectUtils.new("Frame", { Visible = false, Parent = objects.Box, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 0.5, ZIndex = -5 })
        objects.BoxFillGradient = RenderObjectUtils.new("UIGradient", { Parent = objects.BoxFill, Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(0, 0, 0)) })

        entityData.Render = function()
            local character = player.Character
            if not character then
                if not entityData.IsFading then
                    EspHide(entityData)
                    return
                end
            end

            if character then
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                local headPart = character:FindFirstChild("Head")
                if rootPart then
                    entityData.LastCFrame = rootPart.CFrame
                    entityData.LastCharacter = character
                end
                if headPart then
                    entityData.LastHeadCFrame = headPart.CFrame
                end
            end

            if not entityData.LastCFrame then EspHide(entityData) return end
            local rootCFrame = entityData.LastCFrame
            local rootPosition = rootCFrame.Position
            local screenPoint, onScreen = CurrentCamera:WorldToViewportPoint(rootPosition)

            if entityData.IsFading then
                if onScreen then
                    local minX, minY, maxX, maxY = GetBoundingBoxes(rootCFrame, screenPoint, Options["Esp/Scale"].Value, nil)
                    local width = (maxX + 1) - (minX - 1)
                    local height = (maxY + 1) - (minY - 1)
                    objects.FrameHolder.Position = UDim2.fromOffset(minX - 1, minY - 1)
                    objects.FrameHolder.Size = UDim2.fromOffset(width, height)
                else
                    objects.FrameHolder.Visible = false
                end
                return
            end

            if not Toggles["Esp/Enabled"].Value then EspHide(entityData) return end

            local maxDistance = Options["Esp/MaxDistance"].Value or 500
            local distance = (CurrentCamera.CFrame.Position - rootPosition).Magnitude
            if distance > maxDistance then EspHide(entityData) return end

            do
                local health, maxHealth = 0, 100
                if character then health, maxHealth = GetHealth(character) end
                entityData.MaxHealth = maxHealth
                local ratio = math.clamp(health / math.max(maxHealth, 1), 0, 1)
                entityData.HealthRatio = (entityData.HealthRatio or ratio) + (ratio - (entityData.HealthRatio or ratio)) * (Options["Esp/HealthBarSpeed"].Value or 0.1)
                local currentRatio = entityData.HealthRatio

                if currentRatio <= 0.01 then
                    if objects.FrameHolder.Visible then
                        entityData.IsFading = true
                        entityData.HasFadedIn = false
                        EspFade(false, entityData)
                        task.delay(1.1, function()
                            entityData.IsFading = false
                            entityData.LastCFrame = nil
                            entityData.LastCharacter = nil
                            entityData.HealthRatio = nil
                            entityData.LastAlpha = nil
                            entityData.LastHealthBarSide = nil
                            EspHide(entityData)
                            for _, obj in pairs(objects) do
                                if CanChangeTransparency(entityData, obj) then
                                    local transparencyProp = GlobalState.Utility.GetTransparency(obj)
                                    if transparencyProp then obj[transparencyProp] = 0 end
                                end
                            end
                        end)
                    end
                    return
                end

                if ratio == 1 and not entityData.HasFadedIn then
                    entityData.HasFadedIn = true
                    entityData.LastAlpha = nil
                    for _, obj in pairs(objects) do
                        if CanChangeTransparency(entityData, obj) then
                            local transparencyProp = GlobalState.Utility.GetTransparency(obj)
                            if transparencyProp then obj[transparencyProp] = 1 end
                        end
                    end
                    EspShow(entityData)
                    EspFade(true, entityData)
                else
                    EspShow(entityData)
                end
            end

            do
                local distanceLabel = objects.Distance
                if distanceLabel.Visible then
                    local distText = math.floor(distance) .. "m"
                    local textCase = Options["Esp/TextCases"].Value
                    local textWrapper = Options["Esp/TextWrapper"].Value
                    if textWrapper == "[Brackets]" then distText = "[" .. distText .. "]"
                    elseif textWrapper == "{Braces}" then distText = "{" .. distText .. "}" end
                    if textCase == "UPPER" then distText = string.upper(distText)
                    elseif textCase == "lower" then distText = string.lower(distText) end
                    if distanceLabel.Text ~= distText then
                        distanceLabel.Text = distText
                        FixTextPadding(distanceLabel)
                    end
                end

                if Toggles["Esp/FadeOnDistance"].Value then
                    local fadeStart = maxDistance * 0.6
                    local fadeAlpha = math.clamp((distance - fadeStart) / (maxDistance - fadeStart), 0, 1)
                    EspSetTransparency(entityData, fadeAlpha)
                else
                    EspSetTransparency(entityData, 0)
                end
            end

            local minX, minY, maxX, maxY = GetBoundingBoxes(rootCFrame, screenPoint, Options["Esp/Scale"].Value, nil)

            if onScreen then
                local left = minX - 1
                local top = minY - 1
                local width = (maxX + 1) - left
                local height = (maxY + 1) - top
                entityData.IsOnScreen = true
                objects.FrameHolder.Position = UDim2.fromOffset(left, top)
                objects.FrameHolder.Size = UDim2.fromOffset(width, height)
            else
                entityData.IsOnScreen = false
                EspHide(entityData)
                return
            end

            do
                local healthBarEnabled = Toggles["Esp/HealthBar"].Value
                objects.HealthBarHolder.Visible = healthBarEnabled
                local thickness = Options["Esp/HealthBarThickness"].Value or 1
                local offset = 4

                if healthBarEnabled then
                    local currentRatio = entityData.HealthRatio or 1
                    local sideChanged = entityData.LastHealthBarSide ~= "Left"
                    entityData.LastHealthBarSide = "Left"

                    if sideChanged then
                        objects.HealthBarHolder.AnchorPoint = Vector2.new(1, 0)
                        objects.HealthBarHolder.Size = UDim2.new(0, thickness, 1, 2)
                        objects.HealthBarHolder.Position = UDim2.new(0, -offset, 0, -1)
                        objects.HealthBarFill.AnchorPoint = Vector2.new(0, 1)
                        objects.HealthBarFill.Position = UDim2.new(0, 0, 1, 0)
                        objects.HealthBarFillGradient.Rotation = 90
                    end

                    objects.HealthBarFill.Size = UDim2.new(1, 0, currentRatio, 0)

                    local healthBarNumberLabel = objects.HealthBarNumber
                    local showNumber = Toggles["Esp/HealthBarNumber"].Value
                    healthBarNumberLabel.Visible = showNumber and healthBarEnabled
                    if showNumber then
                        local maxHp = entityData.MaxHealth or 100
                        local realHealth = math.clamp(math.round(currentRatio * maxHp), 0, maxHp)
                        if healthBarNumberLabel.Text ~= tostring(realHealth) then
                            healthBarNumberLabel.Text = tostring(realHealth)
                        end
                        local posXOffset = 5 - ((Options["Esp/HealthBarThickness"].Value or 1) - 1)
                        healthBarNumberLabel.AnchorPoint = Vector2.new(1, 0.5)
                        healthBarNumberLabel.Position = UDim2.new(0, -(offset) + posXOffset, 1 - currentRatio, 0)
                    end
                end
            end
        end

        entityData.CharacterConn = player.CharacterAdded:Connect(function()
            task.spawn(function()
                local char = player.Character
                if not char then return end
                local root = char:WaitForChild("HumanoidRootPart", 5)
                if root then
                    task.wait(0.5)
                    UpdateElement(player)
                end
            end)
        end)
        UpdateElement(player)
    end

    local function RemoveEntity(player)
        local entity = GlobalState.Esp.Entities[player]
        if entity then
            if entity.Objects then
                for _, obj in pairs(entity.Objects) do
                    RenderObjectUtils.DestroyRenderObject(obj)
                end
            end
            if entity.CharacterConn then entity.CharacterConn:Disconnect() end
            GlobalState.Esp.Entities[player] = nil
        end
    end

