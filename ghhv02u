        objects.Distance.TextColor3 = Options["Esp/MercDistanceColor"].Value
        objects.HealthBarNumber.TextColor3 = Options["Esp/MercHealthBarNumberColor"].Value
        objects.HealthBarFillGradient.Color = ColorSequence.new {
            ColorSequenceKeypoint.new(0, Options["Esp/MercHealthBarColor1"].Value),
            ColorSequenceKeypoint.new(0.5, Options["Esp/MercHealthBarColor1"].Value:Lerp(Options["Esp/MercHealthBarColor2"].Value, 0.5)),
            ColorSequenceKeypoint.new(1, Options["Esp/MercHealthBarColor2"].Value),
        }

        entityData.Render = function()
            if not mercModel or not mercModel.Parent then
                MercHide(entityData)
                return
            end

            local humanoid = mercModel:FindFirstChildOfClass("Humanoid")
            local rootPart = mercModel:FindFirstChild("HumanoidRootPart")

            if rootPart then
                entityData.LastCFrame = rootPart.CFrame
            end

            if not entityData.LastCFrame then MercHide(entityData) return end

            if not Toggles["Esp/MercEnabled"].Value then MercHide(entityData) return end

            if not humanoid or humanoid.Health <= 0 then
                if objects.FrameHolder.Visible and not entityData.IsFading then
                    entityData.IsFading = true
                    entityData.HasFadedIn = false
                    MercFade(false, entityData)
                    task.delay(Options["Esp/FadeTime"].Value + 0.1, function()
                        entityData.IsFading = false
                        entityData.HealthRatio = nil
                        entityData.LastAlpha = nil
                        MercHide(entityData)
                        for _, obj in pairs(objects) do
                            if CanChangeTransparency(entityData, obj) then
                                local tp = GlobalState.Utility.GetTransparency(obj)
                                if tp then obj[tp] = 0 end
                            end
                        end
                    end)
                end
                return
            end

            local rootCFrame = entityData.LastCFrame
            local rootPosition = rootCFrame.Position
            local screenPoint, onScreen = CurrentCamera:WorldToViewportPoint(rootPosition)

            local maxDistance = Options["Esp/MaxDistance"].Value or 500
            local distance = (CurrentCamera.CFrame.Position - rootPosition).Magnitude
            if distance > maxDistance then MercHide(entityData) return end

            local health, maxHealth = GetMercHealth(mercModel)
            entityData.MaxHealth = maxHealth
            local ratio = math.clamp(health / math.max(maxHealth, 1), 0, 1)
            entityData.HealthRatio = (entityData.HealthRatio or ratio) + (ratio - (entityData.HealthRatio or ratio)) * (Options["Esp/HealthBarSpeed"].Value or 0.1)

            if ratio == 1 and not entityData.HasFadedIn then
                entityData.HasFadedIn = true
                entityData.LastAlpha = nil
                for _, obj in pairs(objects) do
                    if CanChangeTransparency(entityData, obj) then
                        local tp = GlobalState.Utility.GetTransparency(obj)
                        if tp then obj[tp] = 1 end
                    end
                end
                MercShow(entityData)
                MercFade(true, entityData)
            else
                MercShow(entityData)
            end

            if not onScreen then
                entityData.IsOnScreen = false
                MercHide(entityData)
                return
            end
            entityData.IsOnScreen = true

            local minX, minY, maxX, maxY = GetBoundingBoxes(rootCFrame, screenPoint, Options["Esp/Scale"].Value, nil)
            local left = minX - 1
            local top = minY - 1
            local width = (maxX + 1) - left
            local height = (maxY + 1) - top
            objects.FrameHolder.Position = UDim2.fromOffset(left, top)
            objects.FrameHolder.Size = UDim2.fromOffset(width, height)

            objects.BoxGradient.Color = ColorSequence.new {
                ColorSequenceKeypoint.new(0, Options["Esp/MercBoxColor1"].Value),
                ColorSequenceKeypoint.new(1, Options["Esp/MercBoxColor2"].Value),
            }
            objects.Box.Visible = Toggles["Esp/MercBox"].Value
            objects.FullBoxHolder.Visible = Toggles["Esp/MercBox"].Value

            objects.BoxFillGradient.Color = ColorSequence.new {
                ColorSequenceKeypoint.new(0, Options["Esp/MercBoxFillColor1"].Value),
                ColorSequenceKeypoint.new(1, Options["Esp/MercBoxFillColor2"].Value),
            }
            objects.BoxFillGradient.Transparency = NumberSequence.new {
                NumberSequenceKeypoint.new(0, Options["Esp/MercBoxFillColor1"].Transparency or 0.5),
                NumberSequenceKeypoint.new(1, Options["Esp/MercBoxFillColor2"].Transparency or 0.5),
            }
            objects.BoxFill.Visible = Toggles["Esp/MercBoxFill"].Value and Toggles["Esp/MercBox"].Value

            objects.Name.Visible = Toggles["Esp/MercName"].Value
            objects.Name.TextColor3 = Options["Esp/MercNameColor"].Value
            ApplyMercText(objects.Name, CleanMercName(mercModel.Name))

            objects.Distance.Visible = Toggles["Esp/MercDistance"].Value
            objects.Distance.TextColor3 = Options["Esp/MercDistanceColor"].Value
            ApplyMercText(objects.Distance, math.floor(distance) .. "m")

            if Toggles["Esp/FadeOnDistance"].Value then
                local fadeStart = maxDistance * 0.6
                local fadeAlpha = math.clamp((distance - fadeStart) / (maxDistance - fadeStart), 0, 1)
                MercSetTransparency(entityData, fadeAlpha)
            else
                MercSetTransparency(entityData, 0)
            end

            local healthBarEnabled = Toggles["Esp/MercHealthBar"].Value
            objects.HealthBarHolder.Visible = healthBarEnabled
            if healthBarEnabled then
                local thickness = Options["Esp/HealthBarThickness"].Value or 1
                local offset = 4
                local currentRatio = entityData.HealthRatio or 1
                local sideChanged = entityData.LastHealthBarSide ~= "Left"
                entityData.LastHealthBarSide = "Left"
                if sideChanged then
                    objects.HealthBarHolder.AnchorPoint = Vector2.new(1, 0)
                    objects.HealthBarHolder.Size = UDim2.new(0, thickness, 1, 2)
                    objects.HealthBarHolder.Position = UDim2.new(0, -offset, 0, -1)
                    objects.HealthBarFill.AnchorPoint = Vector2.new(0, 1)
                    objects.HealthBarFill.Position = UDim2.new(0, 0, 1, 0)
                    objects.HealthBarFillGradient.Rotation = 90
                end
                objects.HealthBarFill.Size = UDim2.new(1, 0, currentRatio, 0)

                objects.HealthBarFillGradient.Color = ColorSequence.new {
                    ColorSequenceKeypoint.new(0, Options["Esp/MercHealthBarColor1"].Value),
                    ColorSequenceKeypoint.new(0.5, Options["Esp/MercHealthBarColor1"].Value:Lerp(Options["Esp/MercHealthBarColor2"].Value, 0.5)),
                    ColorSequenceKeypoint.new(1, Options["Esp/MercHealthBarColor2"].Value),
                }

                local numLabel = objects.HealthBarNumber
                local showNumber = Toggles["Esp/MercHealthBarNumber"].Value
                numLabel.Visible = showNumber and healthBarEnabled
                if showNumber then
                    local maxHp = entityData.MaxHealth or 100
                    local realHealth = math.clamp(math.round(currentRatio * maxHp), 0, maxHp)
                    if numLabel.Text ~= tostring(realHealth) then
                        numLabel.Text = tostring(realHealth)
