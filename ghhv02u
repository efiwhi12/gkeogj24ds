        objects.SideRight = RenderObjectUtils.new("Frame", { Visible = true, Parent = objects.FrameHolder, Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(1, 0, 0, -4), BackgroundTransparency = 1, Name = "Right" })
        objects.SideBottom = RenderObjectUtils.new("Frame", { Visible = true, Parent = objects.FrameHolder, Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 1, 0), BackgroundTransparency = 1, Name = "Bottom" })
        objects.SideTop = RenderObjectUtils.new("Frame", { Visible = true, Parent = objects.FrameHolder, Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, -1, 0), BackgroundTransparency = 1, Name = "Top" })
        noFadeObjects.Left = objects.SideLeft
        noFadeObjects.Right = objects.SideRight
        noFadeObjects.Bottom = objects.SideBottom
