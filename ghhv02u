    local solveEnv = setmetatable({}, {
        __index = function(_, k)
            local f = math[k]
            if f then return f end
            error("unknown: " .. tostring(k))
        end
    })

    local function parseArgs(...)
        local args = { ... }
        if #args < 3 then return nil end

        local formulas = args[1]
        local varNames = args[2]
        local targets = args[3]
        local knownVars = args[4] or {}
        return formulas, varNames, targets, knownVars
    end

    local function solveSystem(formulas, varNames, targets, knownVars)
        local allVars = {}
        for _, n in ipairs(varNames) do allVars[n] = true end
        for k in pairs(knownVars) do allVars[k] = true end
        for _, f in ipairs(formulas) do
            for letter in f:gmatch("%u") do allVars[letter] = true end
        end

        local unknown = {}
        for name in pairs(allVars) do
            if knownVars[name] == nil then
                table.insert(unknown, name)
            end
        end
        table.sort(unknown)

        if #unknown == 0 then
            local result = {}
            for _, n in ipairs(varNames) do
                table.insert(result, knownVars[n])
            end
            return result
        end

        local MIN, MAX
        if #unknown <= 1 then
            MIN, MAX = 0, 10000
        elseif #unknown == 2 then
            MIN, MAX = 0, 500
        elseif #unknown == 3 then
            MIN, MAX = 0, 50
        else
            MIN, MAX = 0, 20
        end

        local maxAttempts = 10_000_000
        local attempts = 0

        local allParams = {}
        for n in pairs(allVars) do table.insert(allParams, n) end
        table.sort(allParams)

        local fnParams = table.concat(allParams, ", ")

        local body = "local _out = {}\n"
        for i, f in ipairs(formulas) do
            body = body .. "local _r" .. i .. " = (" .. f .. ")\n"
        end
        local retList = {}
        for i = 1, #formulas do table.insert(retList, "_r" .. i) end
        body = body .. "return {" .. table.concat(retList, ",") .. "}\n"

        local src = "local function _solveFn(" .. fnParams .. ")\n" .. body .. "end\nreturn _solveFn"

        local loader = loadstring(src)
        if not loader then
            warn("[Auto-Crate] loadstring failed")
            warn("[Auto-Crate] src:\n" .. src)
            return nil
        end

        local okLoad, checkFn = pcall(loader)
        if not okLoad or type(checkFn) ~= "function" then
            warn("[Auto-Crate] loader() failed:", checkFn)
            return nil
        end

        local solution = {}
        local function brute(idx)
            attempts = attempts + 1
            if attempts > maxAttempts then return false end

            if idx > #unknown then
                local args = {}
                for _, n in ipairs(allParams) do
                    if solution[n] ~= nil then
                        table.insert(args, solution[n])
                    else
                        table.insert(args, knownVars[n])
                    end
                end

                local ok, results = pcall(checkFn, table.unpack(args))
                if ok and type(results) == "table" then
                    for i, target in ipairs(targets) do
                        if math.abs((results[i] or 0) - target) > 0.001 then
                            return false
                        end
                    end
                    return true
                end
                return false
            end

            local name = unknown[idx]
            for val = MIN, MAX do
                solution[name] = val
                if brute(idx + 1) then return true end
            end
            solution[name] = nil
            return false
        end

        if not brute(1) then
            warn("[Auto-Crate] no solution. attempts:", attempts, "unknown:", table.concat(unknown, ","))
            return nil
        end

        local result = {}
        for _, n in ipairs(varNames) do
            if solution[n] ~= nil then
                table.insert(result, solution[n])
            elseif knownVars[n] ~= nil then
                table.insert(result, knownVars[n])
            else
                warn("[Auto-Crate] var", n, "not resolved")
                return nil
            end
        end
        return result
    end

