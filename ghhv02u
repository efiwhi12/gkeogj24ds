local function LoadFont(name, url)
    writefile(name .. ".ttf", game:HttpGet(url))
    local cfg = { Name = name, faces = { { name = "Regular", weight = 400, style = "normal", assetId = getcustomasset(name .. ".ttf") } } }
    writefile(name .. ".json", HttpService:JSONEncode(cfg))
    return Font.new(getcustomasset(name .. ".json"), Enum.FontWeight.Regular)
end

