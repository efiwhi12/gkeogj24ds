    local function createTrailSegment(startPos, endPos)
        local part = Instance.new("Part")
        part.Anchored = true
        part.CanCollide = false
        part.Color = footTrail.Color
        part.Material = Enum.Material.Neon
        part.Size = Vector3.new(footTrail.Width, footTrail.Width, (startPos - endPos).Magnitude)
        part.CFrame = CFrame.new(startPos, endPos) * CFrame.new(0, 0, -part.Size.Z/2)
        part.Parent = workspace
        table.insert(footTrail.parts, { Part = part, Time = os.clock() })
    end

    RunService.Heartbeat:Connect(function()
        if not footTrail.Enabled or not LocalPlayer.Character then
            footTrail.lastPos = nil
            return
        end
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local currentPos = root.Position - Vector3.new(0, 2.5, 0)
        if footTrail.lastPos and (currentPos - footTrail.lastPos).Magnitude > 0.1 then
            createTrailSegment(footTrail.lastPos, currentPos)
        end
        footTrail.lastPos = currentPos

        local currentTime = os.clock()
        for i = #footTrail.parts, 1, -1 do
            if currentTime - footTrail.parts[i].Time > footTrail.Lifetime then
                footTrail.parts[i].Part:Destroy()
                table.remove(footTrail.parts, i)
            end
        end
        while #footTrail.parts > footTrail.Length do
            footTrail.parts[1].Part:Destroy()
            table.remove(footTrail.parts, 1)
        end
    end)

