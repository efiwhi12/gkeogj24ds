    local originalTrailValues = {}

    local function SetupMagicBullets()
        local trails = GetBulletTrails()
        if #trails == 0 then return end

        if next(originalTrailValues) == nil then
            for i, trail in ipairs(trails) do
                originalTrailValues[i] = {
                    Color = trail.Color,
                    LightEmission = trail.LightEmission,
                    Transparency = trail.Transparency,
                    Lifetime = trail.Lifetime,
                    WidthScale = trail.WidthScale,
                    MaxLength = trail.MaxLength,
                }
            end
        end

        if Toggles["World/MagicBulletEnabled"].Value then
            local colorSeq = ColorSequence.new(Options["World/MagicBulletColor"].Value)
            for _, trail in ipairs(trails) do
                trail.Color = colorSeq
                trail.LightEmission = 1.5
                trail.Transparency = NumberSequence.new{
                    NumberSequenceKeypoint.new(0, 0),
                    NumberSequenceKeypoint.new(1, 1),
                }
                trail.Lifetime = Options["World/MagicBulletLifetime"].Value
                trail.WidthScale = NumberSequence.new{
                    NumberSequenceKeypoint.new(0, 0.3),
                    NumberSequenceKeypoint.new(1, 0.3),
                }
                trail.MaxLength = 10000
            end
        else
            for i, trail in ipairs(trails) do
                local orig = originalTrailValues[i]
                if orig then
                    trail.Color = orig.Color
                    trail.LightEmission = orig.LightEmission
                    trail.Transparency = orig.Transparency
                    trail.Lifetime = orig.Lifetime
                    trail.WidthScale = orig.WidthScale
                    trail.MaxLength = orig.MaxLength or 1000
                end
            end
        end
    end

