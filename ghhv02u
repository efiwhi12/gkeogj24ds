            crateESP.items[crate] = nil
        end
    end

    local function ClearAllCrateLabels()
        for crate, _ in pairs(crateESP.items) do
            RemoveCrateLabel(crate)
        end
    end

    local function UpdateCrateESP()
        if not crateESP.enabled then
            if next(crateESP.items) ~= nil then
                ClearAllCrateLabels()
            end
            return
        end

        local seen = {}
        local camPos = CurrentCamera.CFrame.Position
        local maxDist = crateESP.distance

        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == "Crate" and obj:IsA("Model") then
                seen[obj] = true
                if not crateESP.items[obj] then
                    AddCrateLabel(obj)
                end
            end
        end

        for crate, data in pairs(crateESP.items) do
            if not seen[crate] or not crate.Parent then
                RemoveCrateLabel(crate)
            else
                local pos = GetCratePos(crate)
                if not pos then
                    data.Line1.Visible = false
                    data.Line2.Visible = false
                else
                    local distance = (camPos - pos).Magnitude
                    local screenPos, onScreen = CurrentCamera:WorldToViewportPoint(pos)

                    if onScreen and distance <= maxDist then
                        local level, drop = GetCrateInfo(crate)

                        local t1 = level and ("Level " .. level) or "Level ?"
                        if data.Line1.Text ~= t1 then
                            data.Line1.Text = t1
                            FixTextPadding(data.Line1)
                        end

                        local t2 = drop or "?"
                        if data.Line2.Text ~= t2 then
                            data.Line2.Text = t2
                            FixTextPadding(data.Line2)
                        end

                        local textCase = Options["Esp/TextCases"].Value
                        local textWrapper = Options["Esp/TextWrapper"].Value
                        local function wrap(str)
                            local s = str
                            if textCase == "UPPER" then s = string.upper(s)
                            elseif textCase == "lower" then s = string.lower(s) end
                            if textWrapper == "[Brackets]" then s = "[" .. s .. "]"
                            elseif textWrapper == "{Braces}" then s = "{" .. s .. "}" end
                            return s
                        end

                        local final1 = wrap(t1)
                        local final2 = wrap(t2)
                        if data.Line1.Text ~= final1 then data.Line1.Text = final1; FixTextPadding(data.Line1) end
                        if data.Line2.Text ~= final2 then data.Line2.Text = final2; FixTextPadding(data.Line2) end

                        data.Line1.Position = UDim2.fromOffset(screenPos.X, screenPos.Y - 6)
                        data.Line2.Position = UDim2.fromOffset(screenPos.X, screenPos.Y - 6)
                        data.Line1.TextColor3 = crateESP.color
                        data.Line2.TextColor3 = crateESP.color
                        data.Line1.ZIndex = (1000 - math.floor(distance))
                        data.Line2.ZIndex = (1000 - math.floor(distance))

                        local baseTransp = crateESP.transparency
                        if crateESP.fadeDistance then
                            local fadeStart = maxDist * 0.6
                            local fadeAlpha = math.clamp((distance - fadeStart) / (maxDist - fadeStart), 0, 1)
                            data.Line1.TextTransparency = baseTransp + fadeAlpha * (1 - baseTransp)
                            data.Line2.TextTransparency = baseTransp + fadeAlpha * (1 - baseTransp)
                        else
                            data.Line1.TextTransparency = baseTransp
                            data.Line2.TextTransparency = baseTransp
                        end

                        data.Line1.Visible = true
                        data.Line2.Visible = true
                    else
                        data.Line1.Visible = false
                        data.Line2.Visible = false
                    end
                end
            end
        end
    end

