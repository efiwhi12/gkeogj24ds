    local function UpdateItemESP()
        if not itemESP.enabled then
            if next(itemESP.items) ~= nil then
                ClearAllItemLabels()
            end
            return
        end

        local container = GetItemContainer()
        if not container then return end

        local seen = {}
        local camPos = CurrentCamera.CFrame.Position
        local maxDist = itemESP.distance

        for _, obj in ipairs(container:GetChildren()) do
            if IsItemModel(obj) then
                seen[obj] = true
                if not itemESP.items[obj] then
                    AddItemLabel(obj)
                end
            end
        end

        for item, data in pairs(itemESP.items) do
            if not seen[item] or not item.Parent then
                RemoveItemLabel(item)
            else
                local label = data.Label
                local stroke = data.Stroke
                local objPos = GetItemPosition(item)
                local distance = (camPos - objPos).Magnitude
                local screenPos, onScreen = CurrentCamera:WorldToViewportPoint(objPos)

                if onScreen and distance <= maxDist then
                    label.Position = UDim2.fromOffset(screenPos.X, screenPos.Y)
                    label.TextColor3 = itemESP.color
                    label.ZIndex = (1000 - math.floor(distance))

                    local baseTransp = itemESP.transparency
                    if itemESP.fadeDistance then
                        local fadeStart = maxDist * 0.6
                        local fadeAlpha = math.clamp((distance - fadeStart) / (maxDist - fadeStart), 0, 1)
                        label.TextTransparency = baseTransp + fadeAlpha * (1 - baseTransp)
                        stroke.Transparency = baseTransp + fadeAlpha * (1 - baseTransp)
                    else
                        label.TextTransparency = baseTransp
                        stroke.Transparency = baseTransp
                    end

                    label.Visible = true

                    local cleanName = CleanItemName(item.Name)
                    if label.Text ~= cleanName then
                        label.Text = cleanName
                        FixItemTextPadding(label)
                    end

                else
                    label.Visible = false
                end
            end
        end
    end

