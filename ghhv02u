    local function GetCrateLevel(crate)
        local bypassable = crate:FindFirstChild("#Bypassable")
        if not bypassable then return nil end
        local diff = bypassable:FindFirstChild("Difficulty")
        if diff and diff:IsA("IntValue") then
            return diff.Value
        end
        return nil
    end

    local function GetRandomCrateByLevel(level)
        local candidates = {}
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == "Crate" and obj:IsA("Model") then
                local lvl = GetCrateLevel(obj)
                if lvl == level then
                    local ok, cf = pcall(function()
                        local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                        return primary and primary.Position or nil
                    end)
                    if ok and cf then
                        table.insert(candidates, cf)
                    end
                end
            end
        end
        if #candidates == 0 then return nil end
        return candidates[math.random(1, #candidates)]
    end

    local function TeleportToRandomCrate(level)
        local pos = GetRandomCrateByLevel(level)
        if not pos then
            Library:Notify({ Title = "Crates", Description = "Crate level " .. level .. " not found", Time = 2 })
            return
        end
        local target = pos + Vector3.new(0, 5, 0)
        GetTeleportCFrame(target)
    end

