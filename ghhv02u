    local function GetMercHealth(mercModel)
        local humanoid = mercModel:FindFirstChildOfClass("Humanoid")
        if not humanoid then return 0, 100 end

        local hp = humanoid.Health
        local baseMax = humanoid.MaxHealth
        if baseMax <= 0 then baseMax = 100 end

        local shieldVal = 0
        local shield = mercModel:FindFirstChild("#Shield")
        if shield then
            if shield:IsA("ValueBase") then
                shieldVal = tonumber(shield.Value) or 0
            else
                local innerVal = shield:FindFirstChild("Value")
                if innerVal and innerVal:IsA("ValueBase") then
                    shieldVal = tonumber(innerVal.Value) or 0
                end
            end
        end

        local entity = mercESP.entities[mercModel]
        if entity then
            if shieldVal > (entity.MaxShield or 0) then
                entity.MaxShield = shieldVal
            end
            if baseMax > (entity.MaxBaseHealth or 0) then
                entity.MaxBaseHealth = baseMax
            end
        end

        local storedBase = (entity and entity.MaxBaseHealth) or baseMax
        local storedShield = (entity and entity.MaxShield) or shieldVal

        local totalMax = storedBase + storedShield
        local totalHp = hp + shieldVal

        return totalHp, totalMax
    end

    local function MercHide(entity)
        if entity.IsFading then return end
        local fh = entity.Objects.FrameHolder
        if fh and fh.Visible then fh.Visible = false end
    end

    local function MercShow(entity)
        if entity.IsFading then return end
        local fh = entity.Objects.FrameHolder
        if fh and not fh.Visible then fh.Visible = true end
    end

    local function MercFade(fadeIn, entity)
        local targetAlpha = fadeIn and 0 or 1
        local tweenInfo = TweenInfo.new(
            Options["Esp/FadeTime"].Value,
            Enum.EasingStyle[Options["Esp/FadeEasingStyle"].Value],
            Enum.EasingDirection.Out
        )
        for _, object in pairs(entity.Objects) do
            if CanChangeTransparency(entity, object) then
                local tp = GlobalState.Utility.GetTransparency(object)
                if tp then
                    TweenService:Create(object, tweenInfo, { [tp] = targetAlpha }):Play()
                end
            end
        end
    end

    local function MercSetTransparency(entity, alpha)
        if entity.LastAlpha == alpha then return end
        entity.LastAlpha = alpha
        for _, object in pairs(entity.Objects) do
            if CanChangeTransparency(entity, object) then
                local tp = GlobalState.Utility.GetTransparency(object)
                if tp then object[tp] = alpha end
            end
        end
    end

    local function CleanMercName(name)
        local clean = name:gsub("%[%d+%]", "")
        clean = clean:gsub("#%d+", "")
        clean = clean:gsub("%s+$", "")
        clean = clean:gsub("^%s+", "")
        return clean
    end

    local function ApplyMercText(textLabel, rawText)
        local textCase = Options["Esp/TextCases"].Value
        local textWrapper = Options["Esp/TextWrapper"].Value
        local newText = rawText
        if textCase == "UPPER" then newText = string.upper(rawText)
        elseif textCase == "lower" then newText = string.lower(rawText) end
        if textWrapper == "[Brackets]" then newText = "[" .. newText .. "]"
        elseif textWrapper == "{Braces}" then newText = "{" .. newText .. "}" end
        if textLabel.Text ~= newText then
            textLabel.Text = newText
        end
        FixTextPadding(textLabel)
    end

