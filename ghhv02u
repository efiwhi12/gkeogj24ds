    local function GetCrateInfo(crate)
        local bypassable = crate:FindFirstChild("#Bypassable")
        if not bypassable then return nil, nil end
        local diff = bypassable:FindFirstChild("Difficulty")
        local item = bypassable:FindFirstChild("Item")
        local level = diff and diff:IsA("IntValue") and diff.Value or nil
        local drop = item and item:IsA("StringValue") and item.Value or nil
        return level, drop
    end

    local function GetCratePos(crate)
        local ok, cf = pcall(function()
            local primary = crate.PrimaryPart or crate:FindFirstChildWhichIsA("BasePart")
            if primary then return primary.Position end
            local boxCF = crate:GetBoundingBox()
            return boxCF.Position
        end)
        return ok and cf or nil
    end

