    GlobalState.Utility.GetTransparency = function(object)
        if object and object.IsA then
            if object.ClassName == "UIStroke" then return "Transparency"
            elseif object.ClassName == "Frame" then return "BackgroundTransparency"
            elseif object.ClassName == "TextLabel" then return "TextTransparency"
            elseif object.ClassName == "ImageLabel" then return "ImageTransparency"
            end
        end
        return nil
    end

    GlobalState.Utility.GetTextBounds = function(text, font, size, maxWidth)
        local cacheKey = text .. "|" .. tostring(font) .. "|" .. tostring(size) .. "|" .. tostring(maxWidth)
        local cached = TextCache[cacheKey]
        if cached then return cached.X, cached.Y end
        local params = Instance.new("GetTextBoundsParams")
        params.Text = text
        params.RichText = true
        params.Font = font
        params.Size = size
        params.Width = maxWidth or CurrentCamera.ViewportSize.X - 32
        local bounds = TextService:GetTextBoundsAsync(params)
        TextCache[cacheKey] = { X = bounds.X, Y = bounds.Y }
        return bounds.X, bounds.Y
    end

    local HUGE_VALUE = 1e309

    local function FixTextPadding(textLabel)
        local fontName = "SmallestPixel7"
        local offsets = GlobalState.Esp.TextOffsets[fontName]
        local sideName = textLabel.Parent and textLabel.Parent.Name or ""
        local textWidth, textHeight = GlobalState.Utility.GetTextBounds(textLabel.Text, textLabel.FontFace, textLabel.TextSize)
        if offsets.Side and offsets.Side[sideName] then
            local sideOffsets = offsets.Side[sideName]
            textLabel.Size = UDim2.fromOffset(textWidth + sideOffsets.X, textHeight + sideOffsets.Y)
        else
            textLabel.Size = UDim2.fromOffset(textWidth + offsets.X, textHeight + offsets.Y)
        end
    end

    local function GetBoundingBoxes(rootCFrame, screenPos, scale, character)
        local minX, maxX = HUGE_VALUE, -HUGE_VALUE
        local minY, maxY = HUGE_VALUE, -HUGE_VALUE

        if character then
            local minX2, minY2, maxX2, maxY2 = HUGE_VALUE, HUGE_VALUE, -HUGE_VALUE, -HUGE_VALUE
            local modelCFrame, modelSize = character:GetBoundingBox()
            local halfSizeX = modelSize.X * 0.5
            local halfSizeY = modelSize.Y * 0.5
            local halfSizeZ = modelSize.Z * 0.5
            local offsetsX = { halfSizeX, -halfSizeX, halfSizeX, -halfSizeX, halfSizeX, -halfSizeX, halfSizeX, -halfSizeX }
            local offsetsY = { halfSizeY, halfSizeY, -halfSizeY, -halfSizeY, halfSizeY, halfSizeY, -halfSizeY, -halfSizeY }
            local offsetsZ = { halfSizeZ, halfSizeZ, halfSizeZ, halfSizeZ, -halfSizeZ, -halfSizeZ, -halfSizeZ, -halfSizeZ }
            for i = 1, 8 do
                local ox, oy, oz = offsetsX[i], offsetsY[i], offsetsZ[i]
                local worldPos = modelCFrame:PointToWorldSpace(Vector3.new(ox, oy, oz))
                local projX, projY = CurrentCamera:WorldToViewportPoint(worldPos).X, CurrentCamera:WorldToViewportPoint(worldPos).Y
                if projX < minX2 then minX2 = projX end
                if projX > maxX2 then maxX2 = projX end
                if projY < minY2 then minY2 = projY end
                if projY > maxY2 then maxY2 = projY end
            end
            if minX2 ~= HUGE_VALUE then
                return math.floor(minX2), math.floor(minY2), math.floor(maxX2), math.floor(maxY2)
            end
        end

        local headHeight = 2.68 * scale
        local headScreenPos = CurrentCamera:WorldToViewportPoint(rootCFrame.Position + Vector3.new(0, headHeight, 0))
        local heightDiff = headScreenPos.Y - screenPos.Y
        local boxWidth = heightDiff / 1.5
        local centerX = screenPos.X
        local centerY = screenPos.Y
        local leftX = centerX + boxWidth
        local rightX = centerX - boxWidth
        local bottomY = centerY + (boxWidth * 1.15)
        local topY = centerY - (heightDiff * 1.15)
        local corners = {
            Vector2.new(leftX, bottomY), Vector2.new(rightX, topY),
            Vector2.new(leftX, topY), Vector2.new(rightX, bottomY),
        }
        for _, corner in ipairs(corners) do
            if minX > corner.X then minX = corner.X end
            if maxX < corner.X then maxX = corner.X end
            if minY > corner.Y then minY = corner.Y end
            if maxY < corner.Y then maxY = corner.Y end
        end
        return math.floor(minX), math.floor(minY), math.floor(maxX), math.floor(maxY)
    end

    local function CanChangeTransparency(entity, object)
        if object == nil or entity == nil then return false end
        for _, noFadeObj in pairs(entity.NoFade) do
            if noFadeObj == object then return false end
        end
        return true
    end

    local function EspHide(entity)
        if entity.IsFading then return end
        local frameHolder = entity.Objects.FrameHolder
        if frameHolder and frameHolder.Visible == true then
            frameHolder.Visible = false
        end
    end

    local function EspShow(entity)
        if entity.IsFading then return end
        local frameHolder = entity.Objects.FrameHolder
        if frameHolder and frameHolder.Visible == false then
            frameHolder.Visible = true
        end
    end

    local function ApplyTextLabel(textLabel)
        local textCase = Options["Esp/TextCases"].Value
        local textWrapper = Options["Esp/TextWrapper"].Value
        if not GlobalState.Esp.SettingsCache.TextCases[textLabel] then
            local originalText = textLabel.Text
            GlobalState.Esp.SettingsCache.TextCases[textLabel] = {
                Upper = string.upper(originalText),
                Normal = originalText,
                Lower = string.lower(originalText),
            }
        end
        local cachedTexts = GlobalState.Esp.SettingsCache.TextCases[textLabel]
        local newText
        if textCase == "UPPER" then newText = cachedTexts.Upper
        elseif textCase == "lower" then newText = cachedTexts.Lower
        else newText = cachedTexts.Normal end
        if textWrapper == "[Brackets]" then textLabel.Text = "[" .. newText .. "]"
        elseif textWrapper == "{Braces}" then textLabel.Text = "{" .. newText .. "}"
        else textLabel.Text = newText end
        FixTextPadding(textLabel)
    end

    local function EspFade(fadeIn, entity)
        local targetAlpha = fadeIn and 0 or 1
        for _, object in pairs(entity.Objects) do
            if CanChangeTransparency(entity, object) == true then
                local transparencyProp = GlobalState.Utility.GetTransparency(object)
                if transparencyProp then
                    local tween = TweenService:Create(object, GlobalState.Esp.SettingsCache.TweenInformation[1], { [transparencyProp] = targetAlpha })
                    tween:Play()
                end
            end
        end
    end

    local function EspSetTransparency(entity, alpha)
        if entity.LastAlpha == alpha then return end
        entity.LastAlpha = alpha
        for _, object in pairs(entity.Objects) do
            if CanChangeTransparency(entity, object) then
                local transparencyProp = GlobalState.Utility.GetTransparency(object)
                if transparencyProp then object[transparencyProp] = alpha end
            end
        end
    end

    local function GetHealth(character)
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return 0, 100 end
        return humanoid.Health, humanoid.MaxHealth
    end

