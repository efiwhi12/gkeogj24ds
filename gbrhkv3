function SkinUnlocker.CreateSet(Values)
	local Set = {}
	for i = 1, #Values do Set[Values[i]] = true end
	return Set
end

function SkinUnlocker.IsKnife(WeaponName)
	return WeaponName == "Knife"
		or string.find(WeaponName, "Knife",    1, true) ~= nil
		or string.find(WeaponName, "Bayonet",  1, true) ~= nil
		or string.find(WeaponName, "Karambit", 1, true) ~= nil
end

function SkinUnlocker.new()
	local self = setmetatable({}, SkinUnlocker)

	self.Enabled   = false
	self.Destroyed = false

	self.Hooks = { GetData = nil, Namecall = nil, Inventory = {} }

	self.SkinInfo  = {}
	self.Inventory = {}
	self.Loadouts  = { CT = {}, T = {} }

	self.WeaponSets = {
		CT = SkinUnlocker.CreateSet(SkinUnlocker.Teammates.CT),
		T  = SkinUnlocker.CreateSet(SkinUnlocker.Teammates.T),
	}

	self:Collect()
	return self
end

function SkinUnlocker:GetTeamLoadout(Team)  return Client[Team .. "Loadout"] end
function SkinUnlocker:GetTeamFolder(Team)   return SkinFolders:FindFirstChild(Team .. "Folder") end
function SkinUnlocker:IsSpecialSlot(Slot)   return Slot == "Knife" or Slot == "Glove" end
function SkinUnlocker:IsValidTeam(Team)     return Team == "CT" or Team == "T" end
function SkinUnlocker:GetSkinId(W, S)       return W .. "_" .. S end

function SkinUnlocker:RegisterSkin(WeaponName, SkinName, Type)
	if SkinName == "Stock" then return end
	local FullId = self:GetSkinId(WeaponName, SkinName)
	if self.SkinInfo[FullId] then return end

	self.SkinInfo[FullId]  = { Weapon = WeaponName, Skin = SkinName, Type = Type, FullId = FullId }
	self.Inventory[FullId] = { FullId }

	if Type == "Knife" or Type == "Glove" then
		self.Loadouts.CT[FullId] = { FullId }
		self.Loadouts.T[FullId]  = { FullId }
		return
	end
	if Type ~= "Weapon" then return end
	if self.WeaponSets.CT[WeaponName] then self.Loadouts.CT[FullId] = { FullId } end
	if self.WeaponSets.T[WeaponName]  then self.Loadouts.T[FullId]  = { FullId } end
end

function SkinUnlocker:CollectWeapons()
	for _, Folder in SkinsFolder:GetChildren() do
		if not Folder:IsA("Folder") then continue end
		local Type = SkinUnlocker.IsKnife(Folder.Name) and "Knife" or "Weapon"
		for _, Skin in Folder:GetChildren() do
			self:RegisterSkin(Folder.Name, Skin.Name, Type)
		end
	end
end

function SkinUnlocker:CollectGloves()
	for _, Folder in GlovesFolder:GetChildren() do
		if not Folder:IsA("Folder") or Folder.Name == "Model" then continue end
		for _, Skin in Folder:GetChildren() do
			self:RegisterSkin(Folder.Name, Skin.Name, "Glove")
		end
	end
end

function SkinUnlocker:Collect()
	table.clear(self.SkinInfo)
	table.clear(self.Inventory)
	table.clear(self.Loadouts.CT)
	table.clear(self.Loadouts.T)
	self:CollectWeapons()
	self:CollectGloves()
end

function SkinUnlocker:IsManagedSkin(Value)
	return type(Value) == "table"
		and type(Value[1]) == "string"
		and self.SkinInfo[Value[1]] ~= nil
end

function SkinUnlocker:MergeTeam(Team)
	local Loadout = self.Loadouts[Team]
	if not Loadout then return end
	for SkinId, Value in Loadout do
		local L = self:GetTeamLoadout(Team)
		if L then L[SkinId] = Value end
	end
end

function SkinUnlocker:Merge()
	self:MergeTeam("CT")
	self:MergeTeam("T")
end

function SkinUnlocker:RemoveSpecialSlots(Team)
	local Loadout = self:GetTeamLoadout(Team)
	if not Loadout then return end
	for _, Slot in { "Knife", "Glove" } do
		local cur = Loadout[Slot]
		if self:IsManagedSkin(cur) then
			Loadout[Slot] = nil
			Loadout[Slot .. "Over"] = nil
		end
	end
end

function SkinUnlocker:UnmergeTeam(Team)
	local Loadout = self:GetTeamLoadout(Team)
	local Managed = self.Loadouts[Team]
	if not Loadout or not Managed then return end
	for SkinId in Managed do
		local cur = Loadout[SkinId]
		if type(cur) == "table" and cur[1] == SkinId then
			Loadout[SkinId] = nil
		end
	end
	self:RemoveSpecialSlots(Team)
end

function SkinUnlocker:Unmerge()
	self:UnmergeTeam("CT")
	self:UnmergeTeam("T")
end

function SkinUnlocker:ApplySpecialSlot(Team, Slot, Info)
	local TeamFolder = self:GetTeamFolder(Team)
	if TeamFolder then
		local obj = TeamFolder:FindFirstChild(Slot)
		if obj then obj.Value = Info.Skin end
	end
	local Loadout = self:GetTeamLoadout(Team)
	if Loadout then
		Loadout[Slot .. "Over"] = true
		Loadout[Slot] = { Info.FullId }
	end
end

function SkinUnlocker:ApplyWeapon(Team, Info)
	local TeamFolder = self:GetTeamFolder(Team)
	if not TeamFolder then return end
	local w = TeamFolder:FindFirstChild(Info.Weapon)
	if w then w.Value = Info.Skin end
end

function SkinUnlocker:ApplySkin(Team, Slot, Info)
	if self:IsSpecialSlot(Slot) then
		self:ApplySpecialSlot(Team, Slot, Info)
	else
		self:ApplyWeapon(Team, Info)
	end
end

function SkinUnlocker:ApplyToTeams(Team, Slot, Info)
	if Team == "Both" then
		self:ApplySkin("CT", Slot, Info)
		self:ApplySkin("T",  Slot, Info)
	elseif self:IsValidTeam(Team) then
		self:ApplySkin(Team, Slot, Info)
	end
end

function SkinUnlocker:HandleEquip(Packet)
	if type(Packet) ~= "table" or Packet[1] ~= "EquipItem" then return end
	local Team    = Packet[2]
	local Slot    = Packet[3]
	local Wrapper = Packet[4]
	if type(Wrapper) ~= "table" then return end
	local FullId = Wrapper[1]
	if type(FullId) ~= "string" then return end
	local Info = self.SkinInfo[FullId]
	if not Info then return end
	self:ApplyToTeams(Team, Slot, Info)
end

function SkinUnlocker:InstallDataHook()
	if self.Hooks.GetData then return end
	local Orig
	Orig = hookfunction(Data.GetData, function(DataType, ...)
		local Result = Orig(DataType, ...)
		if not self.Enabled or type(Result) ~= "table" then return Result end
		if DataType == "Inventory" then
			for id, v in self.Inventory do Result[id] = v end
		elseif DataType == "CTLoadout" then
			for id, v in self.Loadouts.CT do Result[id] = v end
		elseif DataType == "TLoadout" then
			for id, v in self.Loadouts.T do Result[id] = v end
		end
		return Result
	end)
	self.Hooks.GetData = Orig
end

function SkinUnlocker:InstallInventoryHooks()
	if #self.Hooks.Inventory > 0 then return end
	for _, Conn in getconnections(InventoryEvent.OnClientEvent) do
		local Fn = Conn.Function
		if type(Fn) ~= "function" then continue end
		local Orig
		Orig = hookfunction(Fn, function(DataType, Skins, ...)
			if self.Enabled then
				if DataType == "Inventory" then
					Skins = self.Inventory
				elseif DataType == "CTLoadout" then
					Skins = Client.CTLoadout
				elseif DataType == "TLoadout" then
					Skins = Client.TLoadout
				end
			end
			return Orig(DataType, Skins, ...)
		end)
		table.insert(self.Hooks.Inventory, { Function = Fn, Original = Orig })
	end
end

function SkinUnlocker:InstallNamecallHook()
	if self.Hooks.Namecall then return end
	local Orig
	Orig = hookmetamethod(game, "__namecall", function(Self, ...)
		if self.Enabled and Self == DataEvent and getnamecallmethod() == "FireServer" then
			local args   = { ... }
			local packet = args[1]
			if type(packet) == "table" and packet[1] == "EquipItem" then
				self:HandleEquip(packet)
				return
			end
		end
		return Orig(Self, ...)
	end)
	self.Hooks.Namecall = Orig
end

function SkinUnlocker:InstallHooks()
	self:InstallDataHook()
	self:InstallInventoryHooks()
	self:InstallNamecallHook()
end

function SkinUnlocker:GetOriginalData(DataType)
	if not self.Hooks.GetData then return {} end
	return self.Hooks.GetData(DataType)
end

function SkinUnlocker:GetRefreshData()
	if self.Enabled then
		return self.Inventory, Client.CTLoadout, Client.TLoadout
	end
	return self:GetOriginalData("Inventory"),
		self:GetOriginalData("CTLoadout"),
		self:GetOriginalData("TLoadout")
end

function SkinUnlocker:FireInventoryUpdate()
	local Inv, CT, T = self:GetRefreshData()
	task.defer(function()
		firesignal(InventoryEvent.OnClientEvent, "Inventory", Inv)
		task.defer(function()
			firesignal(InventoryEvent.OnClientEvent, "CTLoadout", CT)
			firesignal(InventoryEvent.OnClientEvent, "TLoadout",  T)
		end)
	end)
end

function SkinUnlocker:Enable()
	if self.Destroyed then return self end
	self:InstallHooks()
	if self.Enabled then
		self:FireInventoryUpdate()
		return self
	end
	self.Enabled = true
	self:Merge()
	self:FireInventoryUpdate()
	return self
end

function SkinUnlocker:Disable()
	if self.Destroyed or not self.Enabled then return self end
	self.Enabled = false
	self:Unmerge()
	self:FireInventoryUpdate()
	return self
end

function SkinUnlocker:Destroy()
	if self.Destroyed then return end
	self:Disable()
	self.Hooks.GetData = nil
	self.Hooks.Namecall = nil
	table.clear(self.Hooks.Inventory)
	table.clear(self.SkinInfo)
	table.clear(self.Inventory)
	table.clear(self.Loadouts.CT)
	table.clear(self.Loadouts.T)
	self.Destroyed = true
end

