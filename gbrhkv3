	local function getTeam(weapon)
		local inCT = SkinUnlocker.CreateSet(SkinUnlocker.Teammates.CT)[weapon]
		local inT  = SkinUnlocker.CreateSet(SkinUnlocker.Teammates.T)[weapon]
		if inCT and inT then return "Both"
		elseif inCT then return "CT"
		elseif inT  then return "T"
		else return nil end
	end

	local function buildSkinData()
		local knifeSkins, gloveSkins, weaponSkins = {}, {}, {}
		if not SkinsFolder then return knifeSkins, gloveSkins, weaponSkins end

		for _, folder in SkinsFolder:GetChildren() do
			if folder:IsA("Folder") then
				local wName = folder.Name
				local team  = getTeam(wName)
				if team then
					if not weaponSkins[wName] then
						weaponSkins[wName] = { team = team, skins = {} }
					end
					for _, skinObj in folder:GetChildren() do
						if skinObj.Name ~= "Stock" then
							table.insert(weaponSkins[wName].skins, skinObj.Name)
						end
					end
				else
					for _, skinObj in folder:GetChildren() do
						if skinObj.Name ~= "Stock" then
							table.insert(knifeSkins, wName .. "_" .. skinObj.Name)
						end
					end
				end
			end
		end

		for _, folder in GlovesFolder:GetChildren() do
			if folder:IsA("Folder") and folder.Name ~= "Model" then
				for _, skinObj in folder:GetChildren() do
					table.insert(gloveSkins, folder.Name .. "_" .. skinObj.Name)
				end
			end
		end

		return knifeSkins, gloveSkins, weaponSkins
	end

	local knifeSkins, gloveSkins, weaponSkins = buildSkinData()
	table.sort(knifeSkins)
	table.sort(gloveSkins)

	local function fireEquip(team, slot, fullId)
		DataEvent:FireServer({
			[1] = "EquipItem",
			[2] = team,
			[3] = slot,
			[4] = { [1] = fullId },
		})
	end

	local function createDropdown(group, weaponName, skins, team)
		local values = { "None" }
		for _, s in ipairs(skins) do table.insert(values, s) end
		group:AddDropdown("Skin_" .. weaponName .. "_" .. team, {
			Values    = values,
			Default   = "None",
			Multi     = false,
			Text      = weaponName,
			Searchable = #skins > 10,
			Callback  = function(Value)
				if Value == "None" then return end
				fireEquip(team, weaponName, weaponName .. "_" .. Value)
			end,
		})
	end

	local function createCategoryDropdown(group, category, skinList, team, itemType)
		local values = { "None" }
		for _, s in ipairs(skinList) do table.insert(values, s) end
		group:AddDropdown("Skin_" .. category .. "_" .. team, {
			Values    = values,
			Default   = "None",
			Multi     = false,
			Text      = category,
			Searchable = #skinList > 10,
			Callback  = function(Value)
				if Value == "None" then return end
				fireEquip(team, itemType, Value)
			end,
		})
	end

	if #knifeSkins > 0 then
		createCategoryDropdown(LeftGroup,  "Knifes", knifeSkins, "CT", "Knife")
		createCategoryDropdown(RightGroup, "Knifes", knifeSkins, "T",  "Knife")
	end
	if #gloveSkins > 0 then
		createCategoryDropdown(LeftGroup,  "Gloves", gloveSkins, "CT", "Glove")
		createCategoryDropdown(RightGroup, "Gloves", gloveSkins, "T",  "Glove")
	end

	local weaponNames = {}
	for w in pairs(weaponSkins) do table.insert(weaponNames, w) end
	table.sort(weaponNames)

	for _, w in ipairs(weaponNames) do
		local d = weaponSkins[w]
		if d.team == "CT" or d.team == "Both" then createDropdown(LeftGroup,  w, d.skins, "CT") end
		if d.team == "T"  or d.team == "Both" then createDropdown(RightGroup, w, d.skins, "T")  end
	end

	SkinUnlocker.new():Enable()
end


